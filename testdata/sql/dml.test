CREATE TABLE d (a INTEGER DEFAULT 7, b TEXT DEFAULT ('x' || 'y'))

statement ok
INSERT INTO d DEFAULT VALUES

query
SELECT a, b FROM d
----
7 | xy

statement error default for c: must not refer to columns
CREATE TABLE bad (b INTEGER, c INTEGER DEFAULT b)

statement error INSERT has 2 target columns but 3 values
