# Compound queries.
query
SELECT name FROM emp WHERE dept = 'eng' UNION SELECT name FROM emp WHERE salary > 84 ORDER BY 1
----
Ana
Bo
Cy
Ed

query
SELECT dept FROM emp UNION ALL SELECT 'hr' ORDER BY 1
----
eng
eng
eng
hr
ops
ops

query
SELECT boss FROM emp INTERSECT SELECT id FROM emp
----
1
4

query
SELECT id FROM emp EXCEPT SELECT boss FROM emp ORDER BY id DESC
----
5
3
2

